---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryTileGrid from '../components/CategoryTileGrid.astro';
import SearchBox from '../components/SearchBox.astro';
import { recipeSource } from '../lib/recipe-source-instance';
import type { CategoryWithCount, Recipe } from '../lib/recipe-source';

// A genuine not-found: no attempt to resolve the path against anything. The client-side
// Slug resolution in ADR 0001 belongs to the authentication milestone, and there is nothing
// unpublished for it to find here.

interface Props {
  categories?: CategoryWithCount[];
  recipes?: Recipe[];
}

const {
  categories = recipeSource.getCategoriesWithCounts(),
  recipes = recipeSource.getAllRecipes(),
} = Astro.props;
---

<BaseLayout title="Page not found · De Re Coquinaria">
  <div class="wrap not-found-page">
    <div class="not-found-card">
      <p class="not-found-code">404</p>
      <h1 class="not-found-title">We can't find that page</h1>
      <p class="hint not-found-hint">It may have moved or never existed. Try a search or one of the categories.</p>
      <SearchBox recipes={recipes} />
    </div>

    <div class="not-found-categories">
      <h2 class="not-found-section-title">Browse by occasion</h2>
      <CategoryTileGrid categories={categories} />
    </div>
  </div>
</BaseLayout>

<style>
  .not-found-page { padding: 64px 0; display: flex; flex-direction: column; gap: 48px }
  .not-found-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 24px;
    padding: 56px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
  }
  .not-found-card :global(.search-box) { align-self: stretch; width: 100%; max-width: 480px }
  .not-found-code { font-family: 'Young Serif', Georgia, serif; font-size: 72px; color: var(--color-accent); line-height: 1 }
  .not-found-title { font-size: 30px }
  .not-found-hint { font-size: 17px; max-width: 420px }
  .not-found-categories { display: flex; flex-direction: column; gap: 20px }
  .not-found-section-title { font-size: 30px }
</style>
