---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { getRecipeSource } from '../../lib/recipe-source-instance';
import { buildCategoryRoutes } from '../../lib/category-routes';
import { withBase } from '../../lib/base-path';
import { distinctTags } from '../../lib/tags';
import type { CategoryWithCount, Recipe } from '../../lib/recipe-source';

export async function getStaticPaths() {
  return buildCategoryRoutes(await getRecipeSource());
}

interface Props {
  category: CategoryWithCount;
  recipes: Recipe[];
}

const { category, recipes } = Astro.props;
const tags = distinctTags(recipes);
---

<BaseLayout title={`${category.name} · De Re Coquinaria`}>
  <div class="wrap category-page">
    <nav aria-label="Breadcrumb" class="hint">
      <a href={withBase('/')}>Home</a> / {category.name}
    </nav>
    <div class="category-header">
      <h1 class="category-title">{category.name}</h1>
      <span class="hint">{category.count} recipes · newest first</span>
    </div>

    {recipes.length === 0 ? (
      <p class="hint category-empty">No Recipes here yet — check back soon.</p>
    ) : (
      <>
        {tags.length > 0 && (
          <div class="tag-filter" role="group" aria-label="Filter by tag" data-tag-filter>
            <button type="button" class="chip chip-lg chip-on" data-tag-value="" aria-pressed="true">All</button>
            {tags.map((tag) => (
              <button type="button" class="chip chip-lg" data-tag-value={tag.slug} aria-pressed="false">{tag.name}</button>
            ))}
          </div>
        )}
        <div class="g3" data-recipe-grid>
          {recipes.map((recipe) => <RecipeCard recipe={recipe} />)}
        </div>
        {tags.length > 0 && (
          <p class="hint category-filter-empty" data-filter-empty hidden>No Recipes carry this Tag here.</p>
        )}
      </>
    )}
  </div>
</BaseLayout>

<style>
  .category-page { padding: 64px 0; display: flex; flex-direction: column; gap: 24px }
  .category-header { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap }
  .category-title { font-size: 44px }
  .category-empty { padding: 48px 0 }
  .tag-filter { display: flex; flex-wrap: wrap; gap: 8px }
</style>

<script>
  // Mechanically mirrors src/lib/tag-filter.ts's filterRecipesByTag against each card's data-tags,
  // which is tested through the RecipeSource seam; this script only does the DOM show/hide.
  const filterGroup = document.querySelector<HTMLElement>('[data-tag-filter]');
  const grid = document.querySelector<HTMLElement>('[data-recipe-grid]');
  const emptyNotice = document.querySelector<HTMLElement>('[data-filter-empty]');

  if (filterGroup && grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-tags]'));

    filterGroup.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-tag-value]');
      if (!button) return;

      const value = button.dataset.tagValue ?? '';
      filterGroup.querySelectorAll('button').forEach((btn) => {
        const on = btn === button;
        btn.classList.toggle('chip-on', on);
        btn.setAttribute('aria-pressed', String(on));
      });

      let visible = 0;
      cards.forEach((card) => {
        const cardTags = (card.dataset.tags ?? '').split(' ').filter(Boolean);
        const show = value === '' || cardTags.includes(value);
        card.hidden = !show;
        if (show) visible += 1;
      });

      if (emptyNotice) emptyNotice.hidden = visible > 0;
    });
  }
</script>
