---
import { withBase } from '../lib/base-path';
---

<footer class="site-footer">
  <div class="wrap site-footer-row">
    <div class="site-footer-brand">De Re Coquinaria <span class="hint">· recipes for two</span></div>
    <nav aria-label="Footer" class="site-footer-nav">
      <a href={withBase('/recipes/')}>All recipes</a>
      <a href={`${withBase('/')}#categories`}>Categories</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--color-border); padding: 32px 0 }
  .site-footer-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap }
  .site-footer-brand { font-family: 'Young Serif', Georgia, serif; font-size: 18px }
  .site-footer-nav { display: flex; gap: 16px }
</style>
