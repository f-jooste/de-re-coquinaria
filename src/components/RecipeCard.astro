---
import { withBase } from '../lib/base-path';
import { placeholderTile } from '../lib/placeholder-tile';
import { recipeMetaLine } from '../lib/recipe-meta';
import { tagSlug, tagDisplayName } from '../lib/tags';
import { categoryName } from '../lib/categories';
import type { Recipe } from '../lib/recipe-source';

interface Props {
  recipe: Recipe;
  // Shown on the Tag page, where a listing crosses Categories and that needs to stay visible.
  showCategories?: boolean;
}

const { recipe, showCategories = false } = Astro.props;
const tile = placeholderTile(recipe.title);
const meta = recipeMetaLine(recipe);
const tagSlugs = recipe.tags.map(tagSlug).join(' ');
const categoryNames = showCategories ? recipe.categories.map(categoryName).filter(Boolean).join(' · ') : null;
---

<a class="card" href={withBase(`/recipes/${recipe.slug}/`)} data-tags={tagSlugs}>
  <div class="card-photo" style={`background: ${tile.bg}; color: ${tile.fg}`}>{tile.initial}</div>
  <div class="card-body">
    <div class="card-title">{recipe.title}</div>
    {categoryNames && <div class="hint">{categoryNames}</div>}
    {meta && <div class="hint">{meta}</div>}
    {recipe.tags.length > 0 && (
      <div class="card-tags">
        {recipe.tags.map((tag) => <span class="chip">{tagDisplayName(tag)}</span>)}
      </div>
    )}
  </div>
</a>

<style>
  .card-photo {
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Young Serif', Georgia, serif;
    font-size: 80px;
  }
  .card-body { padding: 16px; display: flex; flex-direction: column; gap: 10px }
  .card-title { font-weight: 700; font-size: 19px; line-height: 1.25 }
  .card-tags { display: flex; gap: 6px; flex-wrap: wrap }
</style>
